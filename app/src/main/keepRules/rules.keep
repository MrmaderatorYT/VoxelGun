# JNI uses name-based entry points, so the native facades must not be renamed.
-keep class com.ccs.voxelstrike.voxel.NativeBridge { *; }
-keep class com.ccs.voxelstrike.audio.NativeSynth { *; }
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}
# Enum valueOf is used when restoring the persisted profile and settings.
-keepclassmembers enum * {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}
