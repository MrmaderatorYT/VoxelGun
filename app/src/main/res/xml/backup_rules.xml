<?xml version="1.0" encoding="utf-8"?>
<!--
    Career progress, settings, HUD layout and key bindings all live in SharedPreferences, and all
    of it is worth carrying to a new device. Spelled out rather than left to the default so the
    intent is visible when someone adds a new preference file.
-->
<full-backup-content>
    <include domain="sharedpref" path="voxelstrike_profile.xml" />
    <include domain="sharedpref" path="voxelstrike_settings.xml" />
    <include domain="sharedpref" path="voxelstrike_hud.xml" />
    <include domain="sharedpref" path="voxelstrike_keys.xml" />
</full-backup-content>
