<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_scrim"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="10dp"
    android:paddingEnd="28dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_back"
            style="@style/Widget.VoxelStrike.Button.Back"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/menu_back"
            app:icon="@drawable/ic_game_back"
            app:iconGravity="textStart"
            app:iconPadding="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/menu_settings"
            android:textAppearance="@style/TextAppearance.VoxelStrike.ScreenTitle" />

        <Space
            android:layout_width="96dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Graphics -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_quality" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/quality_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <TextView
                    android:id="@+id/text_quality_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <TextView
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_raytracing" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="12sp"
                    android:text="@string/graphics_budget_hint" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_rt_shadows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_rt_shadows" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_rt_gi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_rt_gi" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_rt_reflections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_rt_reflections" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_denoiser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_denoiser" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_taa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_taa" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_bloom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_bloom" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_player_highlights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_player_highlights" />

                <TextView
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_picture" />

                <TextView
                    android:id="@+id/label_contrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_contrast"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_contrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.8"
                    android:valueTo="1.6" />

                <TextView
                    android:id="@+id/label_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_brightness"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.6"
                    android:valueTo="1.3" />

                <TextView
                    android:id="@+id/label_gamma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_gamma"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_gamma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="1.0"
                    android:stepSize="0.05"
                    android:valueFrom="0.5"
                    android:valueTo="2.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_picture_preset"
                    style="@style/Widget.VoxelStrike.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/settings_picture_contrasty" />

                <TextView
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_frame_rate" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/fps_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_adaptive_performance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_adaptive_performance" />

                <TextView
                    android:id="@+id/label_render_scale"
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_render_scale" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_render_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.6"
                    android:valueTo="1.0" />

                <TextView
                    android:id="@+id/label_trace_scale"
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_rt_resolution" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_trace_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="0.5"
                    android:valueFrom="0.25"
                    android:valueTo="1.0" />
            </LinearLayout>

            <!-- Controls and audio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_controls" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_keys"
                    style="@style/Widget.VoxelStrike.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_keys" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_hud"
                    style="@style/Widget.VoxelStrike.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_hud" />

                <TextView
                    android:id="@+id/label_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sensitivity"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.3"
                    android:valueTo="2.5" />

                <TextView
                    android:id="@+id/label_ads_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ads_sensitivity"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_ads_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="0.6"
                    android:valueFrom="0.2"
                    android:valueTo="1.5" />

                <TextView
                    android:id="@+id/label_scope_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_scope_sensitivity"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_scope_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="0.4"
                    android:valueFrom="0.15"
                    android:valueTo="1.2" />

                <TextView
                    android:id="@+id/label_fov"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_fov"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_fov"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="78"
                    android:valueFrom="65"
                    android:valueTo="100" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_aim_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_aim_toggle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_fire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_auto_fire" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_jump"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_auto_jump" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_southpaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_southpaw" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_haptics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_haptics" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_fps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/settings_show_fps" />

                <TextView
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_audio" />

                <TextView
                    android:id="@+id/label_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sfx"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="0.85"
                    android:valueFrom="0"
                    android:valueTo="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.12"
                    android:text="@string/settings_section_backup"
                    android:textAllCaps="true"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/label_backup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backup_hint"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_export_profile"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/settings_backup_export" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_import_profile"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:text="@string/settings_backup_import" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_reset"
                    android:textColor="?attr/colorError" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
