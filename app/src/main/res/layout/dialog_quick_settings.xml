<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_quality" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/quick_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            style="@style/TextAppearance.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_frame_rate" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/quick_fps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/quick_contrast_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_contrast"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/quick_contrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="0.8"
            android:valueTo="1.6" />

        <TextView
            android:id="@+id/quick_brightness_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_brightness"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/quick_brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="0.6"
            android:valueTo="1.3" />

        <TextView
            android:id="@+id/quick_gamma_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_gamma"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
        <com.google.android.material.slider.Slider
            android:id="@+id/quick_gamma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="1.0"
            android:stepSize="0.05"
            android:valueFrom="0.5"
            android:valueTo="2.0" />

        <TextView
            android:id="@+id/quick_volume_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_sfx"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/quick_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="0"
            android:valueTo="1" />

        <TextView
            android:id="@+id/quick_sensitivity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_sensitivity"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/quick_sensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="0.3"
            android:valueTo="2.5" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/quick_auto_jump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/settings_auto_jump" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/quick_player_highlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/settings_player_highlights" />

        <TextView
            android:id="@+id/quick_hud_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hud_size"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/quick_hud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="0.7"
            android:valueTo="1.6" />

        <TextView
            android:id="@+id/quick_opacity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hud_opacity"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/quick_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="0.35"
            android:valueTo="1.0" />
    </LinearLayout>
</ScrollView>
