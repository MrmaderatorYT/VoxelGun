<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ccs.voxelgun.ui.HudView
        android:id="@+id/hud_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        The editing controls stay out of the way of the layout being edited: one slim bar pinned
        to the top centre, with the rarely touched global sliders folded into a sheet under it.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.VoxelGun.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="#E61F1A17"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hud_back"
                    style="@style/Widget.VoxelGun.Button.Back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/menu_back"
                    app:icon="@drawable/ic_game_back"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/colorOutline" />

                <TextView
                    android:id="@+id/hud_item_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:minWidth="96dp"
                    android:text="@string/hud_item_none"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hud_item_smaller"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_minus"
                    app:iconSize="18dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/hud_item_size"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    app:labelBehavior="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hud_item_bigger"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_plus"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/hud_item_percent"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hud_reset_item"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:enabled="false"
                    android:minWidth="0dp"
                    android:text="@string/hud_reset_item_short" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hud_more"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/hud_more" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Global size / opacity / reset: opened from "More", collapsed by default. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hud_sheet"
            style="@style/Widget.VoxelGun.Card"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#E61F1A17"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/hud_size_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hud_size"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/hud_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.7"
                    android:valueTo="1.6"
                    app:labelBehavior="gone" />

                <TextView
                    android:id="@+id/hud_opacity_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hud_opacity"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/hud_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.35"
                    android:valueTo="1.0"
                    app:labelBehavior="gone" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hud_static_joystick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/hud_static_joystick" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hud_presets"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/hud_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hud_slots"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/hud_slots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hud_reset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/hud_reset" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>
