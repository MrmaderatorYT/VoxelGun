<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_scrim"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="10dp"
    android:paddingEnd="28dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keys_back"
            style="@style/Widget.VoxelStrike.Button.Back"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/menu_back"
            app:icon="@drawable/ic_game_back"
            app:iconGravity="textStart"
            app:iconPadding="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/settings_keys"
            android:textAppearance="@style/TextAppearance.VoxelStrike.ScreenTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keys_reset"
            style="@style/Widget.VoxelStrike.Button.Back"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:gravity="end|center_vertical"
            android:text="@string/hud_reset" />
    </LinearLayout>

    <TextView
        android:id="@+id/keys_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/keys_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/keys_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    style="@style/TextAppearance.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keys_mouse" />

                <TextView
                    android:id="@+id/keys_mouse_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keys_mouse_sensitivity"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/keys_mouse_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.2"
                    android:valueTo="3.0" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/keys_invert_y"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/keys_invert_y" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/keys_mouse_hint"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
