    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#8F020304"
                android:centerColor="#00000000"
                android:endColor="#66020304"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
