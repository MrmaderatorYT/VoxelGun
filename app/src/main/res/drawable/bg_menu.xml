<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0B0A09"
                android:centerColor="#161311"
                android:endColor="#241B14"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:startColor="#33FF7A2E"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
