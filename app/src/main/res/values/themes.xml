<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.VoxelStrike.Control" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">5dp</item>
    </style>

    <style name="ShapeAppearance.VoxelStrike.Panel" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.VoxelStrike.BuyPanel" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamilyTopLeft">cut</item>
        <item name="cornerSizeTopLeft">18dp</item>
        <item name="cornerFamilyTopRight">cut</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerFamilyBottomRight">cut</item>
        <item name="cornerSizeBottomRight">18dp</item>
        <item name="cornerFamilyBottomLeft">cut</item>
        <item name="cornerSizeBottomLeft">4dp</item>
    </style>

    <style name="Base.Theme.VoxelStrike" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorSurfaceContainerLowest">#FF05080D</item>
        <item name="colorSurfaceContainerLow">#FF080D13</item>
        <item name="colorSurfaceContainer">#FF0B1119</item>
        <item name="colorSurfaceContainerHigh">#FF101821</item>
        <item name="colorSurfaceContainerHighest">#FF151E28</item>
        <item name="android:colorAccent">@color/game_accent</item>
        <item name="colorControlActivated">@color/game_accent</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.VoxelStrike.Control</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.VoxelStrike.Panel</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.VoxelStrike.Panel</item>
        <item name="materialButtonStyle">@style/Widget.VoxelStrike.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.VoxelStrike.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.VoxelStrike.Card</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/bg_menu</item>
    </style>

    <style name="Theme.VoxelStrike" parent="Base.Theme.VoxelStrike" />

    <style name="Theme.VoxelStrike.Match" parent="Base.Theme.VoxelStrike">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Widget.VoxelStrike.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="backgroundTint">@color/game_button_primary</item>
        <item name="rippleColor">@color/game_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
        <item name="iconTint">@color/md_on_primary</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.VoxelStrike.Button.MenuPrimary" parent="Widget.VoxelStrike.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="strokeColor">@color/game_accent_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.VoxelStrike.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textColor">@color/game_text</item>
        <item name="backgroundTint">@color/game_button_secondary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
        <item name="strokeColor">@color/game_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/game_ripple</item>
    </style>

    <style name="Widget.VoxelStrike.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textColor">@color/game_text</item>
        <item name="backgroundTint">@color/game_button_secondary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
        <item name="strokeColor">@color/game_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/game_ripple</item>
    </style>

    <style name="Widget.VoxelStrike.Button.MenuSecondary" parent="Widget.VoxelStrike.Button.Outlined">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="iconTint">@color/game_hud</item>
        <item name="iconPadding">7dp</item>
        <item name="iconSize">17dp</item>
    </style>

    <style name="Widget.VoxelStrike.Button.Back" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="android:textColor">@color/game_hud</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
        <item name="rippleColor">@color/game_ripple</item>
        <item name="iconTint">@color/game_hud</item>
    </style>

    <style name="Widget.VoxelStrike.Button.SelectorArrow" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/game_hud</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
        <item name="rippleColor">@color/game_ripple</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.VoxelStrike.Button.BuyTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:textColor">@color/game_buy_tab_text</item>
        <item name="backgroundTint">@color/game_buy_tab_background</item>
        <item name="strokeColor">@color/game_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
        <item name="rippleColor">@color/game_ripple</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.VoxelStrike.Button.BuyAction" parent="Widget.VoxelStrike.Button.Tonal">
        <item name="android:minWidth">84dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.VoxelStrike.Button.BuyReturn" parent="Widget.VoxelStrike.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/game_accent_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.VoxelStrike.Button.BuyClose" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">25sp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/game_text_muted</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/game_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.VoxelStrike.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/game_panel</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/game_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Panel</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.VoxelStrike.Card.Profile" parent="Widget.VoxelStrike.Card">
        <item name="cardBackgroundColor">@color/game_panel_high</item>
        <item name="strokeColor">#8BFF8A1F</item>
    </style>

    <style name="Widget.VoxelStrike.Card.BuyWallet" parent="Widget.VoxelStrike.Card">
        <item name="cardBackgroundColor">#E6121A24</item>
        <item name="strokeColor">#8BFF8A1F</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
    </style>

    <style name="Widget.VoxelStrike.Card.BuyWeapon" parent="Widget.VoxelStrike.Card">
        <item name="cardBackgroundColor">#E60C131C</item>
        <item name="strokeColor">#5C5E6F80</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VoxelStrike.Control</item>
    </style>

    <style name="TextAppearance.VoxelStrike.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.VoxelStrike.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/game_text</item>
    </style>

    <style name="TextAppearance.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/game_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
