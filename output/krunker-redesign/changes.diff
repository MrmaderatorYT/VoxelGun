+    private static void farmBuilding(MapBuilder b, int x, int z, int width, int depth,
+                                     int wall, int alt, int roof, String name) {
+        b.slab(x - 3, z - 4, x + width + 2, z + depth + 3, G - 1, Materials.DIRT);
+        countryBuilding(b, x, z, width, depth, 8, wall, alt, roof);
+        // Two opposite entrances and a cross door keep each farm building useful to infantry.
+        b.doorway(x + width - 1, G, z + depth / 2, 0, 5, 5);
+        b.fill(x + 3, G, z + depth - 7, x + 7, G + 1, z + depth - 4, Materials.WOOD);
+        b.crate(x + width - 7, G, z + 4, 3, Materials.CRATE, Materials.WOOD_DARK);
+        float pixel = Math.min(.36f, (width - 5f) / (name.length() * 4 + 1));
+        DecorRecipes.sign(b.scenery(), x + 2, G + 5.6f, z - .16f, name, pixel, roof);
+        DecorRecipes.awning(b.scenery(), x + width / 2f - 5, G + 5, z - 2, 10, roof);
+    }
