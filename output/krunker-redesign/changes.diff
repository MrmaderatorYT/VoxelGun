+    /** Short axes, computed from authored sites, are included before the terrain is graded. */
+    private static boolean siteAccess(int x, int z) {
+        for (int[] road : WAYSTATION_ROADS) {
+            if (x >= road[0] && x <= road[2] && z >= road[1] && z <= road[3]) return true;
+        }
+        return false;
+    }
+
+    private static int[][] waystationRoads() {
+        int[][] roads = new int[WAYSTATIONS.length][4];
+        int[] avenues = {16, 160, 320, 480, 623};
+        for (int i = 0; i < WAYSTATIONS.length; i++) {
+            int[] site = WAYSTATIONS[i];
+            int cx = site[0] + site[2] / 2, cz = site[1] + site[3] / 2;
+            int routeX = 16, routeZ = 96;
+            for (int candidate : avenues)
+                if (Math.abs(cx - candidate) < Math.abs(cx - routeX)) routeX = candidate;
+            for (int candidate : ROUTE_Z)
+                if (Math.abs(cz - candidate) < Math.abs(cz - routeZ)) routeZ = candidate;
+            if (Math.abs(cx - routeX) < Math.abs(cz - routeZ)) {
+                roads[i] = new int[]{Math.min(cx, routeX), cz - 3, Math.max(cx, routeX), cz + 3};
+            } else roads[i] = new int[]{cx - 3, Math.min(cz, routeZ), cx + 3, Math.max(cz, routeZ)};
+        }
+        return roads;
+    }
