+                Materials.WOOD_DARK};
+        int[] colors = {Materials.TRIM_RED, Materials.TRIM_BLUE, Materials.ROOF_TEAL};
+        for (int i = 0; i < WAYSTATIONS.length; i++) {
+            int[] site = WAYSTATIONS[i];
+            int x = site[0], z = site[1], w = site[2], d = site[3];
+            int color = colors[i % colors.length];
+            // Chalet, open equipment shelter and shop silhouettes alternate within each hamlet.
+            if (i == 6 || i == 8 || i == 13) {
+                b.slab(x, z, x + w - 1, z + d - 1, 2, Materials.CONCRETE);
+                b.fill(x, 3, z + d - 2, x + w - 1, 7, z + d - 1, Materials.WOOD);
+                for (int px : new int[]{x, x + w - 1}) for (int pz : new int[]{z, z + d - 1})
+                    b.fill(px, 3, pz, px, 10, pz, Materials.WOOD_DARK);
+                gable(b, x - 2, z - 2, x + w + 1, z + d + 1, 11, color, false);
+                b.crate(x + 3, 3, z + d - 7, 4, Materials.CRATE, Materials.WOOD_DARK);
+                b.fill(x + w - 10, 3, z + d - 7, x + w - 4, 5, z + d - 4, Materials.WOOD);
+                b.doorway(x + w / 2, 3, z + d - 1, 1, 7, 6);
+                b.clear(x + w / 2 - 3, 3, z + d - 2, x + w / 2 + 3, 8, z + d);
+            } else {
+                if ((i & 1) == 0) chalet(b, x, z, w, d, walls[i % walls.length], color);
+                else shop(b, x, z, w, d, walls[i % walls.length], color);
+                b.doorway(x, 3, z + d / 2, 0, 5, 5);
+                b.doorway(x + w - 1, 3, z + d / 2, 0, 5, 5);
+            }
+            float pixel = Math.min(.34f, (w - 5f) / (names[i].length() * 4 + 1));
+            DecorRecipes.sign(b.scenery(), x + 2, 8.4f, z - .16f, names[i], pixel, color);
+            // Timber shutters and compact awnings give the white/timber façades clear accents.
